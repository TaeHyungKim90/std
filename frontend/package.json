{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"dependencies": {
		"@fullcalendar/core": "^6.1.20",
		"@fullcalendar/daygrid": "^6.1.20",
		"@fullcalendar/interaction": "^6.1.20",
		"@fullcalendar/react": "^6.1.20",
		"@fullcalendar/timegrid": "^6.1.20",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^13.5.0",
		"@tiptap/core": "3.30.4",
		"@tiptap/extension-bubble-menu": "3.30.4",
		"@tiptap/extension-color": "3.30.4",
		"@tiptap/extension-floating-menu": "3.30.4",
		"@tiptap/extension-font-family": "3.30.4",
		"@tiptap/extension-highlight": "3.30.4",
		"@tiptap/extension-image": "3.30.4",
		"@tiptap/extension-link": "3.30.4",
		"@tiptap/extension-subscript": "3.30.4",
		"@tiptap/extension-superscript": "3.30.4",
		"@tiptap/extension-table": "3.30.4",
		"@tiptap/extension-table-cell": "3.30.4",
		"@tiptap/extension-table-header": "3.30.4",
		"@tiptap/extension-table-row": "3.30.4",
		"@tiptap/extension-text-align": "3.30.4",
		"@tiptap/extension-text-style": "3.30.4",
		"@tiptap/extension-underline": "3.30.4",
		"@tiptap/extension-youtube": "3.30.4",
		"@tiptap/pm": "3.30.4",
		"@tiptap/react": "3.30.4",
		"@tiptap/starter-kit": "3.30.4",
		"axios": "^1.18.0",
		"dayjs": "^1.11.20",
		"dompurify": "3.4.13",
		"emoji-picker-react": "^4.18.0",
		"html-react-parser": "^5.2.17",
		"lucide-react": "^0.577.0",
		"pdfjs-dist": "^6.2.108",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-hot-toast": "^2.6.0",
		"react-router-dom": "^7.18.2",
		"react-scripts": "^5.0.1",
		"web-vitals": "^2.1.4"
	},
	"overrides": {
		"websocket-driver": "0.7.5",
		"nth-check": "^2.0.1",
		"serialize-javascript": "^7.0.3",
		"shell-quote": "^1.9.0",
		"nanoid": "^3.3.18",
		"form-data": "^4.0.6",
		"svgo": "^2.8.3",
		"underscore": "^1.13.8",
		"browserslist": "^4.28.7",
		"brace-expansion@1": "1.1.18",
		"brace-expansion@2": "2.1.4",
		"js-yaml@3": "3.15.1",
		"js-yaml@4": "4.3.1",
		"fast-uri": "3.1.7",
		"resolve-url-loader": "5.0.0",
		"postcss": "^8.5.18",
		"@tootallnate/once": "2.0.1",
		"body-parser": "1.20.6",
		"http-proxy-middleware": "2.0.10",
		"launch-editor": "2.14.1",
		"postcss-selector-parser@6": "6.1.3",
		"postcss-selector-parser@7": "7.1.3",
		"qs": "6.16.0",
		"uuid": "11.1.1",
		"webpack-dev-server": "5.2.6",
		"@tiptap/core": "3.30.4",
		"@tiptap/pm": "3.30.4"
	},
	"scripts": {
		"prestart": "node scripts/copy-pdf-worker.js",
		"start": "react-scripts start",
		"prebuild": "node scripts/copy-pdf-worker.js && node scripts/verify-production-env.js",
		"build": "react-scripts build",
		"test": "react-scripts test",
		"test:ci": "react-scripts test --watchAll=false",
		"lint": "eslint \"src/**/*.{js,jsx}\" --max-warnings 0",
		"lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix --max-warnings 0",
		"eject": "react-scripts eject"
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest"
		],
		"plugins": [
			"simple-import-sort",
			"unused-imports"
		],
		"rules": {
			"simple-import-sort/imports": "warn",
			"simple-import-sort/exports": "warn",
			"unused-imports/no-unused-imports": "warn",
			"no-unused-vars": "off",
			"unused-imports/no-unused-vars": [
				"warn",
				{
					"vars": "all",
					"varsIgnorePattern": "^_",
					"args": "after-used",
					"argsIgnorePattern": "^_"
				}
			],
			"react-hooks/rules-of-hooks": "error",
			"react-hooks/exhaustive-deps": "warn"
		},
		"overrides": [
			{
				"files": [
					"**/*.test.js",
					"**/*.test.jsx"
				],
				"rules": {
					"unused-imports/no-unused-vars": "off"
				}
			}
		]
	},
	"jest": {
		"moduleNameMapper": {
			"^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
			"^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
			"^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js"
		}
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"autoprefixer": "^10.4.27",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"postcss": "^8.5.18",
		"tailwindcss": "^3.4.19"
	}
}
