{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"dependencies": {
		"@fullcalendar/core": "6.1.21",
		"@fullcalendar/daygrid": "6.1.21",
		"@fullcalendar/interaction": "6.1.21",
		"@fullcalendar/react": "6.1.21",
		"@fullcalendar/timegrid": "6.1.21",
		"@tiptap/core": "3.30.4",
		"@tiptap/extension-bubble-menu": "3.30.4",
		"@tiptap/extension-color": "3.30.4",
		"@tiptap/extension-floating-menu": "3.30.4",
		"@tiptap/extension-font-family": "3.30.4",
		"@tiptap/extension-highlight": "3.30.4",
		"@tiptap/extension-image": "3.30.4",
		"@tiptap/extension-link": "3.30.4",
		"@tiptap/extension-subscript": "3.30.4",
		"@tiptap/extension-superscript": "3.30.4",
		"@tiptap/extension-table": "3.30.4",
		"@tiptap/extension-table-cell": "3.30.4",
		"@tiptap/extension-table-header": "3.30.4",
		"@tiptap/extension-table-row": "3.30.4",
		"@tiptap/extension-text-align": "3.30.4",
		"@tiptap/extension-text-style": "3.30.4",
		"@tiptap/extension-underline": "3.30.4",
		"@tiptap/extension-youtube": "3.30.4",
		"@tiptap/pm": "3.30.4",
		"@tiptap/react": "3.30.4",
		"@tiptap/starter-kit": "3.30.4",
		"axios": "1.20.0",
		"dayjs": "1.11.23",
		"dompurify": "3.4.13",
		"emoji-picker-react": "4.20.2",
		"exceljs": "4.4.0",
		"html-react-parser": "5.2.17",
		"lucide-react": "0.577.0",
		"pdfjs-dist": "6.3.289",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hot-toast": "2.6.0",
		"react-router-dom": "7.18.3",
		"web-vitals": "5.3.0"
	},
	"overrides": {
		"nanoid": "3.3.18",
		"form-data": "4.0.6",
		"browserslist": "4.28.9",
		"brace-expansion@1": "1.1.18",
		"js-yaml": "4.3.2",
		"postcss": "8.5.28",
		"@tiptap/core": "3.30.4",
		"@tiptap/pm": "3.30.4"
	},
	"scripts": {
		"prestart": "node scripts/copy-pdf-worker.js",
		"start": "vite",
		"prebuild": "node scripts/copy-pdf-worker.js && node scripts/verify-production-env.js",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:ci": "vitest run",
		"lint": "eslint \"src/**/*.{js,jsx}\" --max-warnings 0",
		"lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix --max-warnings 0"
	},
	"eslintConfig": {
		"root": true,
		"env": {
			"browser": true,
			"es2022": true
		},
		"globals": {
			"process": "readonly"
		},
		"extends": [
			"eslint:recommended",
			"plugin:react/recommended",
			"plugin:react/jsx-runtime",
			"plugin:react-hooks/recommended"
		],
		"parserOptions": {
			"ecmaVersion": "latest",
			"sourceType": "module",
			"ecmaFeatures": {
				"jsx": true
			}
		},
		"settings": {
			"react": {
				"version": "detect"
			}
		},
		"plugins": [
			"react",
			"react-hooks",
			"simple-import-sort",
			"unused-imports"
		],
		"rules": {
			"simple-import-sort/imports": "warn",
			"simple-import-sort/exports": "warn",
			"unused-imports/no-unused-imports": "warn",
			"no-unused-vars": "off",
			"unused-imports/no-unused-vars": [
				"warn",
				{
					"vars": "all",
					"varsIgnorePattern": "^_",
					"args": "after-used",
					"argsIgnorePattern": "^_"
				}
			],
			"react/prop-types": "off",
			"react/display-name": "off",
			"no-constant-condition": [
				"error",
				{
					"checkLoops": false
				}
			],
			"no-mixed-spaces-and-tabs": "off",
			"react-hooks/rules-of-hooks": "error",
			"react-hooks/exhaustive-deps": "warn"
		},
		"overrides": [
			{
				"files": [
					"**/*.test.js",
					"**/*.test.jsx"
				],
				"globals": {
					"vi": "readonly",
					"describe": "readonly",
					"it": "readonly",
					"test": "readonly",
					"expect": "readonly",
					"beforeEach": "readonly",
					"afterEach": "readonly"
				},
				"rules": {
					"unused-imports/no-unused-vars": "off"
				}
			}
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@vitejs/plugin-react": "5.2.0",
		"autoprefixer": "10.5.5",
		"eslint": "8.57.1",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "5.2.0",
		"eslint-plugin-simple-import-sort": "12.1.1",
		"eslint-plugin-unused-imports": "4.4.1",
		"jsdom": "27.4.0",
		"postcss": "8.5.28",
		"tailwindcss": "3.4.19",
		"vite": "7.3.6",
		"vitest": "3.2.7"
	}
}
